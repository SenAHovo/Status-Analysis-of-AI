# Copy to .env and supply your own credentials, or run ai-status bootstrap.
# Process environment takes priority over .env. Never commit real keys.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
GLM_EMBEDDING_API_KEY=
GLM_EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_EMBEDDING_MODEL=embedding-3
GLM_EMBEDDING_DIMENSIONS=2048
API_TIMEOUT_SECONDS=60
TAVILY_API_KEY=
TAVILY_MCP_URL=https://mcp.tavily.com/mcp/
# The shared local Chroma server used by the controller and Document Agent.
CHROMA_CLIENT_MODE=http
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
